{
  "id": "restaurantCreate",
  "securityDomains": [
    "ManageMealOrder"
  ],
  "endPoints": [ ],
  "outboundData": {
    "outboundEndPoints": [
      {
        "name": "restaurantCreateVars",
        "type": "outboundVariable",
        "variableScope": "flow",
        "values": [
          {
            "outboundPath": "restaurantName",
            "value": "<% nameWidget.value %>"
          },
          {
            "outboundPath": "restaurantType",
            "value": "<% typeWidget.value %>"
          },
          {
            "outboundPath": "restaurantActive",
            "value": "<% activeWidget.value %>"
          }
        ]
      }
    ]
  },
  "presentation": {
    "pageType": "edit",
    "title": {
      "type": "title",
      "label": "Create a Restaurant"
    },
    "body": {
      "type": "section",
      "horizontal": false,
      "children": [
        {
          "type": "text",
          "enabled": false,
          "label": "Instructions",
          "value": "Use this form to register a new restaurant. Include the restaurant's name and the type of cuisine they serve. If the restaurant is currently accepting orders, select the Active checkbox."
        },
        {
          "type": "text",
          "required": true,
          "id": "nameWidget",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "typeWidget",
          "label": "Type"
        },
        {
          "type": "checkBox",
          "id": "activeWidget",
          "label": "Active"
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "mainMenuLink"
        }
      ]
    }
  }
}